{
  "name": "@zettabytes/api-client",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Client HTTP tipado gerado a partir do OpenAPI do FastAPI (fonte única da verdade).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@zettabytes/typescript-config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
