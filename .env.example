# ─── Ambiente ────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Banco de dados (docker compose) ─────────────────────────
POSTGRES_PORT=5442
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://zettabytes:zettabytes@localhost:5442/zettabytes
TEST_DATABASE_URL=postgresql+asyncpg://zettabytes:zettabytes@localhost:5442/zettabytes_test
REDIS_URL=redis://localhost:6379/0

# ─── Segurança ───────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Chave Fernet para criptografar tokens da Meta em repouso:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── HTTP ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3100"]
NEXT_PUBLIC_API_URL=http://localhost:8100
