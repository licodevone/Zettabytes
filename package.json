{
  "name": "zettabytes",
  "version": "1.0.0",
  "private": true,
  "description": "Zettabytes — plataforma SaaS de automação e chatbots com IA generativa para WhatsApp (Meta Tech Provider).",
  "license": "MIT",
  "author": "Luis E. S. Pinheiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/licodevone/Zettabytes.git"
  },
  "bugs": {
    "url": "https://github.com/licodevone/Zettabytes/issues"
  },
  "homepage": "https://github.com/licodevone/Zettabytes#readme",
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "chatbot",
    "ai-agents",
    "rag",
    "fastapi",
    "nextjs",
    "turborepo",
    "multi-tenant",
    "saas"
  ],
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bootstrap": "turbo run setup",
    "codegen": "turbo run generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@zettabytes/api",
    "db:seed": "turbo run db:seed --filter=@zettabytes/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
