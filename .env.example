# ─── Ambiente ────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Banco de dados (docker compose) ─────────────────────────
POSTGRES_PORT=5442
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://zettabytes:zettabytes@localhost:5442/acmebr_zettabytes
TEST_DATABASE_URL=postgresql+asyncpg://zettabytes:zettabytes@localhost:5442/acmebr_zettabytes_test
REDIS_URL=redis://localhost:6379/0

# ─── Segurança ───────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Chave Fernet para criptografar tokens da Meta em repouso:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── HTTP ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3100"]
NEXT_PUBLIC_API_URL=http://localhost:8100

# ─── Atendimento ACMEbr: chat web e número próprio do WhatsApp ───
# Mesmo segredo de ATENDIMENTOS_SITE_KEY na landing page.
# SITE_CHAT_KEY=gere-um-segredo-compartilhado
SITE_SLUG=acmebr
# Número completo com código do país e DDD (para o botão da landing page).
# WHATSAPP_NUMBER=55DDDNUMERO
# Dados da conta Meta; configure somente no servidor, nunca NEXT_PUBLIC_*.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_API_VERSION=versao-ativa-do-seu-app-no-formato-vN.N
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
