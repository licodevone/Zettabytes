{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "setup": {
      "cache": false
    },
    "openapi": {
      "cache": false
    },
    "generate": {
      "dependsOn": [
        "@zettachat/api#openapi"
      ],
      "inputs": [
        "openapi.json"
      ],
      "outputs": [
        "src/schema.d.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "test": {
      "outputs": []
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "db:migrate"
      ]
    }
  }
}
